{
    "variables": {
        "aws_access_key": "{{env `AWS_ACCESS_KEY_ID`}}",
        "aws_secret_key": "{{env `AWS_SECRET_ACCESS_KEY`}}",
        "aws_session_token": "{{env `AWS_SESSION_TOKEN`}}",
        "aws_subnet_id": "{{env `AWS_SUBNET_ID`}}",
        "aws_vpc_id": "{{env `AWS_VPC_ID`}}",
        "aws_instance_type": "{{env `AWS_INSTANCE_TYPE`}}",
        "aws_source_ami_win_golden": "{{env `AWS_SOURCE_AMI_WIN_GOLDEN`}}",
        "aws_region": "{{env `AWS_REGION`}}",
        "aws_winrm_username": "{{env `AWS_WINRM_USERNAME`}}"
    },

    "builders": [
        {
            "type": "amazon-ebs",
            "communicator": "winrm",
            "winrm_username": "{{user `aws_winrm_username`}}",
            "user_data_file": "../boot_config/winrm_bootstrap.ps1",            
            "winrm_insecure": true,
            "winrm_use_ssl": true,
            "force_deregister": true,
            "ami_name": "windows-webserver-v1.0.2",            
            "access_key": "{{user `aws_access_key`}}",
            "secret_key": "{{user `aws_secret_key`}}",
            "token": "{{user `aws_session_token`}}",
            "region": "{{user `aws_region`}}",
            "source_ami": "{{user `aws_source_ami_win_golden`}}",
            "instance_type": "{{user `aws_instance_type`}}",
            "vpc_id": "{{user `aws_vpc_id`}}",
            "subnet_id": "{{user `aws_subnet_id`}}"
        }
    ],
    
    "Provisioners": [ 
        {
            "type": "ansible",
            "extra_arguments": [
                "--extra-vars",
                "ansible_shell_type=powershell ansible_shell_executable=None ansible_winrm_server_cert_validation=ignore"
              ],
            "playbook_file": "../playbooks/install_webserver.yml",
            "user": "{{user `aws_winrm_username`}}",
            "use_proxy": false
        },
        {
            "type": "ansible",
            "extra_arguments": [
                "--extra-vars",
                "ansible_shell_type=powershell ansible_shell_executable=None ansible_winrm_server_cert_validation=ignore"
              ],
            "playbook_file": "../playbooks/install_urlrewrite.yml",
            "user": "{{user `aws_winrm_username`}}",
            "use_proxy": false
        },
        {
            "type": "ansible",
            "extra_arguments": [
                "--extra-vars",
                "ansible_shell_type=powershell ansible_shell_executable=None ansible_winrm_server_cert_validation=ignore"
              ],
            "playbook_file": "../playbooks/install_webdeploy.yml",
            "user": "{{user `aws_winrm_username`}}",
            "use_proxy": false
        },
        {
            "type": "ansible",
            "extra_arguments": [
                "--extra-vars",
                "ansible_shell_type=powershell ansible_shell_executable=None ansible_winrm_server_cert_validation=ignore"
              ],
            "playbook_file": "../playbooks/install_aspnetmvc.yml",
            "user": "{{user `aws_winrm_username`}}",
            "use_proxy": false
        },
        {
            "type": "ansible",
            "extra_arguments": [
                "--extra-vars",
                "ansible_shell_type=powershell ansible_shell_executable=None ansible_winrm_server_cert_validation=ignore"
              ],
            "playbook_file": "../playbooks/install_aspnetmvc4.yml",
            "user": "{{user `aws_winrm_username`}}",
            "use_proxy": false
        },
        {
            "type": "ansible",
            "extra_arguments": [
                "--extra-vars",
                "ansible_shell_type=powershell ansible_shell_executable=None ansible_winrm_server_cert_validation=ignore"
              ],
            "playbook_file": "../playbooks/cleanup_defaultiis.yml",
            "user": "{{user `aws_winrm_username`}}",
            "use_proxy": false
        },
        {
            "type": "inspec",
            "Profile": "inspec.rb",
            "inspec_env_vars": ["CHEF_LICENSE=accept"]
        },
        {
            "type": "powershell",
            "inline": [
                "C:/ProgramData/Amazon/EC2-Windows/Launch/Scripts/InitializeInstance.ps1 -Schedule",
                "C:/ProgramData/Amazon/EC2-Windows/Launch/Scripts/SysprepInstance.ps1 -NoShutdown"
            ]
        }  
    ]
}